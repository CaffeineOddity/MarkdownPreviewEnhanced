# Normalize line endings for text; keep binaries untouched.
* text=auto

# Binary assets — never apply CRLF conversion (corrupts fonts / minified JS).
*.woff  binary
*.woff2 binary
*.ttf   binary
*.otf   binary
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.webp  binary
*.ico   binary
*.zip   binary
*.min.js  binary
*.min.css binary

# Exclude non-runtime files from git archive / GitHub source zipballs
# (Package Control with tags:true downloads these archives).
/.gitattributes     export-ignore
/.gitignore         export-ignore
/AGENTS.md          export-ignore
/README.md          export-ignore
/build.sh           export-ignore
/release.sh         export-ignore
/st_package_reviewer.sh export-ignore
/mpe_core/pygments/formatters/img.py export-ignore
/docs/              export-ignore
/img/               export-ignore
/dist/              export-ignore
*.sublime-project   export-ignore
*.sublime-workspace export-ignore
*.sublime-keymap.example export-ignore
